// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ReservationStatus {
  PENDING
  CANCELLED
}

model Reservation {
  id                   String            @id @default(cuid())
  customerName         String
  phone                String
  reservationTime      DateTime
  departureTime        DateTime?
  partySize            Int?
  memo                 String?
  status               ReservationStatus @default(PENDING)
  dayBeforeReminderSentAt DateTime?
  reminderSentAt       DateTime?
  followUpSentAt       DateTime?
  checkoutNoticeSentAt DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([reservationTime])
}

// 문자 발송 시도 기록. 관리자 화면의 "발송 이력"에서 보여주고,
// 사장님이 fly logs 없이도 발송 성공/실패를 확인할 수 있게 한다.
model MessageLog {
  id           String   @id @default(cuid())
  customerName String
  phone        String
  messageType  String // DAY_BEFORE | REMINDER | CHECKOUT_NOTICE | FOLLOW_UP
  success      Boolean
  error        String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model Settings {
  id                     String   @id @default("singleton")
  cafeName               String?
  address                String?
  parkingInfo            String?
  rules                  String?
  checkoutDaysAfter      Int?
  checkoutTime           String?
  reviewLink             String?
  giftEventContact       String?
  adOptOutNumber         String?
  sendDayBefore          Boolean  @default(true)
  sendReminder           Boolean  @default(true)
  sendCheckoutNotice     Boolean  @default(true)
  sendFollowUp           Boolean  @default(true)
  checkoutNoticeTemplate String?
  followUpTemplate       String?
  updatedAt              DateTime @updatedAt
}
