# SQLite 데이터베이스 파일 위치 (수정하지 않아도 됩니다)
DATABASE_URL="file:./prisma/dev.db"

# 관리자 로그인 비밀번호 (직접 정하세요, 외부에 노출되지 않도록 주의)
ADMIN_PASSWORD=change-me-to-a-strong-password

# 로그인 세션 쿠키 서명에 쓰이는 임의의 긴 문자열 (직접 랜덤하게 생성해서 넣으세요)
SESSION_SECRET=change-me-to-a-random-long-string

# 문자 메시지에 표시될 가게 이름
CAFE_NAME=우리 키즈카페

# 아래 3개는 선택 사항입니다. 채워두면 예약 안내 문자에 자동으로 추가됩니다.
# 비워두면 해당 줄은 문자에서 그냥 빠집니다. 문구가 길어질수록 SMS(단문) 대신
# LMS(장문)로 자동 전환되어 건당 비용이 조금 더 나갑니다 (앱이 자동으로 판단해서 전환합니다).
CAFE_ADDRESS=서울시 OO구 OO로 123, 2층
CAFE_PARKING_INFO=건물 지하 1층 주차장 이용 가능 (2시간 무료)
CAFE_RULES=실내화/양말 착용 필수, 보호자 동반 필수

# 솔라피(Solapi, https://solapi.com) API 키 - 콘솔 > API Key 관리에서 발급
SOLAPI_API_KEY=
SOLAPI_API_SECRET=

# 문자를 발송할 발신번호 (반드시 솔라피에 사전 등록/인증된 번호여야 합니다)
SOLAPI_SENDER_NUMBER=0212345678

# 앤트로픽(Anthropic, https://console.anthropic.com) API 키 - 예약창 캡처 사진으로
# 예약 정보를 자동 입력하는 기능에 사용됩니다. 콘솔 > API Keys에서 발급하세요.
ANTHROPIC_API_KEY=
